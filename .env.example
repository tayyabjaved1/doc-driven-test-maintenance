# Local-only convenience for running scripts by hand during Stage 2/3 of the
# porting checklist. In CI, these are repo secrets (see config.yml's
# `credentials` section for the exact names) -- never commit a filled-in
# .env, and never reuse CI's token values locally.
#
# See docs/CREDENTIALS.md before filling any of these in.

# A model API key for the agent step (Stage 3 onward). Not read by any
# script in this repo except the agent action itself.
ANTHROPIC_API_KEY=

# Read+write on the test-case store ONLY. The broker (scripts/lib/broker.mjs)
# is the one place that reads this.
STORE_TOKEN=

# Read PRs, write issues/labels on the repo named in config.yml's
# detection.repo. Used by detect-prs.mjs, label-and-track.mjs, publish.mjs.
REPO_OPS_TOKEN=

# Only set this if your docs live in a different repo than detection.repo.
CROSS_REPO_TOKEN=
